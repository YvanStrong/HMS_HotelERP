{
  "cli": { "version": ">= 7.0.0" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:8080",
        "EXPO_PUBLIC_TAX_RATE": "0.18",
        "EXPO_PUBLIC_ALLOW_CLEARTEXT": "true"
      }
    },
    "staging": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://192.168.2.85:8080",
        "EXPO_PUBLIC_TAX_RATE": "0.18",
        "EXPO_PUBLIC_ALLOW_CLEARTEXT": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://192.168.2.85:8080",
        "EXPO_PUBLIC_TAX_RATE": "0.18",
        "EXPO_PUBLIC_ALLOW_CLEARTEXT": "true"
      }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "android": { "buildType": "app-bundle" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://your-production-hms.com",
        "EXPO_PUBLIC_TAX_RATE": "0.18",
        "EXPO_PUBLIC_ALLOW_CLEARTEXT": "false"
      }
    }
  },
  "submit": {
    "production": {
      "android": { "track": "internal" },
      "ios": { "appleId": "REPLACE", "ascAppId": "REPLACE" }
    }
  }
}
