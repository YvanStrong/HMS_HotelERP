# Copy to .env.local and adjust.
# Backend must allow CORS from this origin (see SecurityConfig: localhost patterns).

# Full API base (no trailing slash). Examples:
#   http://localhost:8080
#   https://hotelerp.rw/Hotel   ← API under a path; set server.servlet.context-path=/Hotel on Spring (or nginx equivalent)
# If this is set, NEXT_PUBLIC_API_BASE_PATH is ignored.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Same-site only: if NEXT_PUBLIC_API_URL is empty, browser uses origin + this path (must start with /).
# Example: NEXT_PUBLIC_API_BASE_PATH=/Hotel  →  https://hotelerp.rw/Hotel
# NEXT_PUBLIC_API_BASE_PATH=

# UUID from Setup Initialize (or your seeded hotel). Required for deep links from the home page.
# Postman collection variable hotelId is the same value.
NEXT_PUBLIC_DEFAULT_HOTEL_ID=
