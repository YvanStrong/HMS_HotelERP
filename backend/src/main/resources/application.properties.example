# Export these as environment variables or add to a .env file (do not commit secrets).

DB_NAME=hms
DB_USER=hms
DB_PASSWORD=your_password_here

# --- Required for production (local profile provides safe defaults for dev) ---

# JWT signing secret — min 32 chars. Replaces the old JWT_SECRET variable.
HMS_JWT_SECRET=replace_with_at_least_32_characters_random_string

# Same value must match Postman setupToken / X-Setup-Token.
HMS_SETUP_TOKEN=replace_with_strong_random_token_for_first_setup_only

# Full JDBC URL for the database (local profile defaults to jdbc:postgresql://localhost:5432/hms).
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/${DB_NAME}

# Comma-separated allowed CORS origins (local profile defaults to http://localhost:3000).
HMS_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Public base URL returned in invoice links etc. (local profile defaults to http://localhost:8080).
HMS_PUBLIC_BASE_URL=http://localhost:8080

# Base URL of the Next.js frontend — used in password-reset email links.
HMS_FRONTEND_BASE_URL=http://localhost:3000

# HMS_CHECK_OUT_LAST_NIGHT_INCLUSIVE=true — treat API check-out as last night of stay (room free from next calendar day).

# Optional: defaults to 8080 in application.properties when unset
# SERVER_PORT=8082

# Optional: serve the API under a URL prefix (matches NEXT_PUBLIC_API_URL or path + /api/v1/...).
# Example: server.servlet.context-path=/Hotel  →  http://localhost:8080/Hotel/swagger-ui/index.html
# The JAR file name (e.g. Hotel.jar) does not set this; you configure it explicitly or via reverse proxy.
# server.servlet.context-path=/Hotel

# Mobile POS: require shift before orders (default true). Override per hotel via hotels.pos_require_shift.
# hms.pos.require-shift=true

# Guest self-order READY alerts (optional). VAPID = browser push; Twilio = SMS if guest left a phone on the order.
# hms.self-order.notify.vapid-public-key=
# hms.self-order.notify.vapid-private-key=
# hms.self-order.notify.vapid-subject=mailto:ops@example.com
# hms.self-order.notify.twilio-account-sid=
# hms.self-order.notify.twilio-auth-token=
# hms.self-order.notify.twilio-from-number=
