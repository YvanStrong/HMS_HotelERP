# Copy to application.properties (do not commit secrets) or export as environment variables.

DB_NAME=hms
DB_USER=hms
DB_PASSWORD=your_password_here

# Required for production. If unset, application.properties uses local dev defaults (change them).
JWT_SECRET=replace_with_at_least_32_characters_random_string
# Same value must match Postman setupToken / X-Setup-Token (defaults documented in application.properties).
SETUP_TOKEN=replace_with_strong_random_token_for_first_setup_only

spring.datasource.url=jdbc:postgresql://localhost:5432/${DB_NAME}
spring.datasource.username=${DB_USER}
spring.datasource.password=${DB_PASSWORD}

hms.jwt.secret=${JWT_SECRET}
hms.setup.token=${SETUP_TOKEN}

# Optional: defaults to 8080 in application.properties when unset
# SERVER_PORT=8082

# Optional: serve the API under a URL prefix (matches NEXT_PUBLIC_API_URL or path + /api/v1/...).
# Example: server.servlet.context-path=/Hotel  →  http://localhost:8080/Hotel/swagger-ui/index.html
# The JAR file name (e.g. Hotel.jar) does not set this; you configure it explicitly or via reverse proxy.
# server.servlet.context-path=/Hotel

# Guest self-order READY alerts (optional). VAPID = browser push; Twilio = SMS if guest left a phone on the order.
# hms.self-order.notify.vapid-public-key=
# hms.self-order.notify.vapid-private-key=
# hms.self-order.notify.vapid-subject=mailto:ops@example.com
# hms.self-order.notify.twilio-account-sid=
# hms.self-order.notify.twilio-auth-token=
# hms.self-order.notify.twilio-from-number=
